# ==============================================================================
# BLINKIT AI SHOPPING COACH - SINGLE CENTRAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# All AI credentials and server URLs are managed in this single root .env file.
# Copy this file to .env and insert your API keys below.

# ------------------------------------------------------------------------------
# 1. Cloudflare Workers AI Credentials (Primary Provider)
# Get Account ID & Token from https://dash.cloudflare.com/
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# ------------------------------------------------------------------------------
# 2. OpenAI API Credentials (Alternative Provider)
# Get API Key from https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Google Gemini API Credentials (Alternative Provider)
# Get API Key from https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Server & Frontend Connection Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
